@echo off
chcp 65001 >nul
REM Полный цикл: сбор новостей за период, анализ и Excel-отчёт.
REM Запуск: auto_parse_export.bat [дополнительные параметры cli.py collect]
REM Например: auto_parse_export.bat --days 30

echo ========================================
echo СБОР НОВОСТЕЙ И ОТЧЁТ В EXCEL
echo ========================================

REM Проверяем наличие Python
where py >nul 2>nul
if %errorlevel% neq 0 (
    echo Ошибка: Python не найден. Установите Python 3.8+ или используйте 'python' вместо 'py'
    pause
    exit /b 1
)

echo.
echo Что будет сделано:
echo   1. Сбор новостей за 7 дней из всех источников, без лимитов
echo   2. Догрузка описаний статей за этот период
echo   3. Анализ упоминаний компаний и разметка материалов
echo   4. Excel-отчёт в папке exports\
echo.
echo Прогон занимает несколько минут. Подробный лог: logs\
echo.

py cli.py collect %*

if %errorlevel% equ 0 (
    echo.
    echo ========================================
    echo ГОТОВО
    echo ========================================
    echo Отчёт лежит в папке exports\
) else (
    echo.
    echo ========================================
    echo ОШИБКА ПРИ ВЫПОЛНЕНИИ
    echo ========================================
    echo Смотрите последний файл в папке logs\ — там трейсбек.
)

echo.
pause
